<!doctype html>
<html><head><meta charset="utf-8"><title>Heimdall CTF Report</title><style>
body{background:#0b0d10;color:#e8e6df;font:14px/1.5 system-ui,Segoe UI,Arial;margin:0;padding:32px} .wrap{max-width:1100px;margin:auto}
h1,h2{color:#e0a458}.card{border:1px solid #2b3038;background:#12161c;border-radius:12px;padding:18px;margin:16px 0}
pre{white-space:pre-wrap;background:#080a0d;border:1px solid #242a32;padding:12px;border-radius:8px}.muted{color:#8e949c}.ok{color:#7fb069}.warn{color:#e0a458}.bad{color:#c8553d}
table{width:100%;border-collapse:collapse}td,th{border-bottom:1px solid #2b3038;padding:8px;text-align:left}
</style></head><body><div class="wrap"><h1>Heimdall CTF Report</h1><p class="muted">Generated by Heimdall Watchtower.</p><div class="card"><h2>Captured Flags</h2><pre>{{ flags }}</pre></div><div class="card"><h2>Attack Path</h2><pre>{{ timeline }}</pre></div><div class="card"><h2>Raw Output</h2><pre>{{ output }}</pre></div></div></body></html>
